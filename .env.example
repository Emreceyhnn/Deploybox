# ==============================================================================
# DeployBox Central Environment Configuration (Template)
# Copy this file to .env and fill in the secrets.
# ==============================================================================

# Node / App Environment (development | production)
NODE_ENV=development

# Database (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-to-a-long-random-value
POSTGRES_DB=deploybox
DATABASE_URL=postgres://postgres:change-me-to-a-long-random-value@localhost:5432/deploybox

# Redis Cache & Queue
REDIS_PASSWORD=change-me-to-a-long-random-value
REDIS_URL=redis://:change-me-to-a-long-random-value@localhost:6379
ConnectionStrings__Redis=localhost:6379,password=change-me-to-a-long-random-value

# GitHub OAuth App Credentials
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_SECRET_KEY=your-github-oauth-client-secret
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret

# NextAuth & Encryption
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-a-32-char-random-secret
JWT_SECRET=generate-a-32-char-random-secret
ENCRYPTION_KEY=generate-a-base64-encoded-32-byte-key

# Orchestrator & Internal API Communication
ORCHESTRATOR_API_TOKEN=dev-only-change-me-before-deploy
ClientApiUrl=http://localhost:3000
